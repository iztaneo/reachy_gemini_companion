# =======================================================
# CONFIGURACIÓN DE CORREO ELECTRÓNICO Y LLM - REACHY COMPANION
# Copia este archivo como .env para activar el correo real:
# cp .env.example .env
# =======================================================

# 🔑 Proveedores de IA (Claude / Gemini)
ANTHROPIC_API_KEY=tu_api_key_de_anthropic_aqui
GEMINI_API_KEY=tu_api_key_de_gemini_aqui
LLM_PROVIDER=claude

# 📧 Configuración de Correo Electrónico Real (IMAP / SMTP)
# Para Gmail: Activa Verificación en 2 Pasos y genera una 'Contraseña de Aplicación' en:
# https://myaccount.google.com/apppasswords
EMAIL_USER=tu_correo@gmail.com
EMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Servidores por defecto para Gmail (ajustar si usas Outlook o servidor de Indra):
IMAP_SERVER=imap.gmail.com
SMTP_SERVER=smtp.gmail.com
